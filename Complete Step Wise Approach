    a.application_id,
    a.applicant_name,
    a.application_date,
    a.income,
    a.loan_amount,
    c.credit_score,
    c.score_date
from bronze_apps a
left join bronze_scores c
    on a.application_id = c.application_id
    and c.score_date >= a.application_date

