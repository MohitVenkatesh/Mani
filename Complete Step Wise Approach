import random
import pandas as pd
from datetime import datetime, timedelta

def generate_applications(num=1000):
    data = []
    base_date = datetime.now() - timedelta(days=30)
    for i in range(num):
        app_date = base_date + timedelta(minutes=random.randint(0, 43200))
        data.append({
            'application_id': i + 1,
            'applicant_name': f'Applicant_{i+1}',
            'application_date': app_date,
            'income': random.randint(30000, 150000),
            'loan_amount': random.randint(5000, 50000)
        })
    return pd.DataFrame(data)

def generate_credit_scores(num=1000):
    data = []
    base_date = datetime.now() - timedelta(days=29)
    for i in range(num):
        score_date = base_date + timedelta(minutes=random.randint(0, 43200))
        data.append({
            'application_id': i + 1,
            'credit_score': random.randint(300, 850),
            'score_date': score_date
        })
    return pd.DataFrame(data)

# Save CSV for ingestion
applications = generate_applications()
credit_scores = generate_credit_scores()
applications.to_csv('applications.csv', index=False)
credit_scores.to_csv('credit_scores.csv', index=False)

